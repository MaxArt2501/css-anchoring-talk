---
import pkg from '../../package.json';
---
<p-slide id="misplaced">
  <label for="misplaced-btn">Select a language</label>
  <button
    type="button"
    id="misplaced-btn"
    command="--next"
    commandfor={pkg.name}>Choose&hellip;</button
  >
  <p-fragment index="0" p-effect="move natural" p-duration="2">
    <img src="../img/cursor-windows.svg" class="cursor" p-fragment="0" p-effect="click" p-delay="2" p-duration="2">
  </p-fragment>
  <ul popover p-fragment>
    <li>🇬🇧 English</li>
    <li>🇫🇷 Français</li>
    <li>🇮🇹 Italiano</li>
    <li>🇪🇸 Español</li>
  </ul>
</p-slide>
<style>
  #misplaced,
  #extra-long,
  #fixed-scroll {
    [p-effect="move natural"] {
      position: absolute;
      --from-x: 1em;
      --from-y: 8.5em;

      > img {
        height: 2em;
      }
    }
  }
  #misplaced,
  #extra-long {
    button,
    input {
      display: flex;
      justify-content: space-between;
      font-family: inherit;
      font-size: inherit;
      border: 0.1em solid #000;
      padding: 0.1em 0.3em;
      background: white;
      border-radius: 0.25em;
      width: 15em;
    }
    button {
      color: gray;
      font-style: italic;
      text-align: start;

      &::after {
        content: "\25BC";
        font-style: normal;
        color: #000;
      }
    }
    ul {
      list-style: "";
      border: 0.1em gray;
      border-style: outset;
      padding: 0 0.5em;
    }
  }
  #misplaced {
    button {
      width: 10em;
    }
    ul {
      width: max-content;
      inset: 8em auto auto 14em;
      margin: 0;
    }
    [p-effect="move natural"] {
      --to-x: 9em;
      --to-y: 2em;
    }
  }
</style>
<p-slide id="extra-long">
  <h4>Intl money transfer</h4>
  <label for="currency-amount">Amount</label>
  <input
    type="number"
    name="currency-amount"
    id="currency-amount"
    value="750"
  />
  <label for="currency-btn">Currency</label>
  <button
    type="button"
    id="currency-btn"
    command="--next"
    commandfor={pkg.name}>Choose&hellip;</button
  >
  <p-fragment index="0" p-effect="move natural" p-duration="2">
    <img src="../img/cursor-windows.svg" class="cursor" p-fragment="0" p-effect="click" p-delay="2" p-duration="2">
  </p-fragment>
  <ul popover p-fragment>
    <li>U.S. dollar (USD)</li>
    <li>Euro (EUR)</li>
    <li>Japanese yen (JPY)</li>
    <li>Pound sterling (GBP)</li>
    <li>Renminbi (CNY)</li>
    <li>Swiss franc (CHF)</li>
    <li>Australian dollar (AUD)</li>
    <li>Canadian dollar (CAD)</li>
    <li>Hong Kong dollar (HKD)</li>
    <li>Singapore dollar (SGD)</li>
  </ul>
</p-slide>
<style>
  #extra-long {
    label {
      margin-top: 0.5em;
    }
    button {
      anchor-name: --currency-btn;
    }
    ul {
      position-anchor: --currency-btn;
      width: 15em;
      inset: anchor(end) auto auto anchor(start);
      background: ivory;
      &::before {
        content: none;
      }
    }
    [p-effect="move natural"] {
      --to-x: 14.1em;
      --to-y: 4.5em;
    }
  }
</style>
<p-slide>
  <svg viewBox="0 40 640 580" width="0">
    <g id="latinWiki">
      <text y="40">Ortus et institutio (1841-1865)</text>
      <text y="102">Familia medicorum rei publicae faventium</text>
      <text>
        <tspan x="0" y="159">Georgius Beniaminus Clemenceau natus est die 28 Septembris</tspan>
        <tspan x="0" y="188">1841 in vico Mouilleron-en-Pareds, in domo avorum</tspan>
        <tspan x="0" y="216">maternorum, gentis Gautreau, ubi mater Emma parere maluerat.</tspan>
        <tspan x="0" y="245">Familia Clemenceau ex agrorum dominis et medicis regionis</tspan>
        <tspan x="0" y="273">quae Bocage vocatur erat: medici in ea gente inde a saeculo</tspan>
        <tspan x="0" y="302">septimo decimo fuerunt, et proavus, Petrus Paulus Clemenceau,</tspan>
        <tspan x="0" y="330">exercituum occidentalium medicus tempore rerum novarum,</tspan>
        <tspan x="0" y="359">postea in concilio legibus ferendis sedit. Duo praedia familia</tspan>
        <tspan x="0" y="387">possidebat: Aubraie, villam in vico La Réorthe, et Le Colombier,</tspan>
        <tspan x="0" y="416">villam rusticam apud Mouchamps, ubi Georgius sepultus est.</tspan>
        <tspan x="0" y="444">Cum illa Vendea regi et Ecclesiae fidelissima esset, familia tamen</tspan>
        <tspan x="0" y="473">Clemenceau partes contrarias sequebatur, eorum scilicet qui</tspan>
        <tspan x="0" y="501">Bleus vocabantur: hi erant cives litteris culti, </tspan><tspan class="link-like">Voltarii</tspan><tspan> studiosi, rei</tspan>
        <tspan x="0" y="530">publicae dediti.</tspan>
      </text>
      <text>
        <tspan x="0" y="579">E schola privata Monfort egressus, Georgius lyceum Namnetense</tspan>
        <tspan x="0" y="608">frequentavit, quod hodie eius nomine appellatur. Discipulus</tspan>
        <tspan x="0" y="636">ingeniosus sed inconstans, amorem Graeciae antiquae ibi</tspan>
        <tspan x="0" y="665">concepit, cuius litteras per totam vitam lectitavit; Romam contra</tspan>
        <tspan x="0" y="693">aversabatur. Primis studiis anno 1858 absolutis, die 1 Novembris</tspan>
        <tspan x="0" y="721">eiusdem anni scholae medicinae Namnetensi nomen dedit, ubi</tspan>
        <tspan x="0" y="750">tres annos studuit et probationem eorum quos externos</tspan>
        <tspan x="0" y="778">(externes) vocant superavit; anno 1861 Lutetiam petivit ut studia</tspan>
        <tspan x="0" y="807">perficeret.</tspan>
      </text>
    </g>
  </svg>
  <div class="fixed-scroll">
    <svg viewBox="0 40 640 580">
      <use href="#latinWiki" p-fragment="1" p-effect="move" style="--to-y: -220px" />
      <rect x="630" y="40" height="400" width="10" rx="5" fill="#0005" p-fragment="1" p-effect="fade & move" style="--to-y: 180px"/>
    </svg>
    <p-fragment index="0" p-effect="move natural" p-duration="2">
      <img src="../img/cursor-windows.svg" class="cursor" p-fragment="1" aria-hidden="false">
    </p-fragment>
    <p-fragment index="0" p-effect="fade" p-delay="2" popover="manual">
      François-Marie Arouet, 1694-1778
    </p-fragment>
  </div>
</p-slide>
<style is:global>
  #latinWiki {
    text {
      font-family: inherit;
      font-size: 21px;
      font-weight: normal;
      text-anchor: start;

      &:first-of-type {
        font-size: 31.5px;
      }
      &:nth-of-type(-n + 2) {
        font-weight: bold;
        alignment-baseline: hanging;
      }
      tspan {
        alignment-baseline: hanging;
        &.link-like {
          fill: var(--brand-color);
          text-decoration: underline;
        }
      }
    }
  }
  .fixed-scroll {
    height: 100%;
    display: flex;
    justify-content: center;

    [p-effect="move natural"] {
      --from-x: -13em;
      --from-y: 2em;
      --to-x: 3.3em;
      --to-y: 9.8em;

      > img {
        height: 1em;
      }
    }
    [p-effect="fade"] {
      position: absolute;
      display: block;
      inset: 34.8em auto auto 33.5em;
      font-size: 45%;
      filter: drop-shadow(0 0 .25em #000);
      --tooltip-bg: color-mix(in srgb, var(--brand-color), white 70%);
    }
  }
</style>
<p-slide>
  <ul id="folders">
    <li>
      Documents
      <ul>
        <li>Assessment_final</li>
        <li>Long<p-fragment p-effect="reveal">, very very</p-fragment> long filename</li>
        <li>My passwords</li>
      </ul>
    </li>
    <li>Movies</li>
    <li>Pictures</li>
  </ul>
</p-slide>
<style>
  #folders {
    line-height: 1lh;
    padding: 0;
    width: 12em;

    &, ul {
      margin: 0 auto;
      list-style-type: '';
    }
    ul {
      padding-inline: 1em 0;
    }
    li {
      &::before {
        content: '📂';
        display: inline-block;
        width: 1.1em;
        position: relative;
        z-index: 1;
        text-indent: 0;
      }
      li::before {
        content: '📄';
      }
    }
    li li {
      position: relative;
      text-indent: -1.1em;
      padding-inline-start: 1.1em;

      &::after {
        content: '';
        border-style: dashed;
        border-width: 0 0 .1em .1em;
        position: absolute;
        inset: auto 100% .5lh auto;
        width: .5em;
        height: 1lh;
      }
    }

    p-fragment {
      white-space: nowrap;
      text-indent: 0;
    }
  }
</style>
<p-slide id="how-arrows">
  <svg viewBox="0 0 200 150">
    <ellipse cx="50" cy="40" rx="40" ry="25" fill="cyan"/>
    <text x="50" y="40">A</text>
    <ellipse cx="150" cy="110" rx="40" ry="25" fill="#faa"/>
    <text x="150" y="110">B</text>
    <path d="M80,60L120,90" stroke-width="2" p-fragment p-effect="drawing" pathLength="100"/>
    <g fill="red" p-fragment p-effect="zoom fade">
      <path d="M99 87a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3c.603-.006 6-1 6-5 0-2-2-4-5-4-2.441 0-4 2-4 3a3 3 0 1 1-6 0c0-4.878 4.58-9 10-9 8 0 11 5.982 11 11 0 4.145-2.277 7.313-6.413 8.92-.9.351-1.79.587-2.587.747V84a3 3 0 0 1-3 3"/>
      <circle cx="99" cy="92" r="3"/>
    </g>
  </svg>
</p-slide>
<style>
  #how-arrows {
    text {
      font-size: 20px;
    }
    svg :not(text) {
      stroke: black;
    }
    [p-fragment] {
      transform-origin: center;
    }
  }
</style>