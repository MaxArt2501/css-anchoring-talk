</p-slide>
<p-slide>
	<Code lang="css" code={`{#4;insert{.tree {
	--tree-name: var({#3;highlight blue{--item-name}#}, ident('--tree{#5;reveal{-}#}'{#5;reveal{ {#5;highlight red{random(0, 99999)}#}}#}));
}}#}.item {
	{#2;reveal{{#3;highlight blue{--item-name}#}}#}{#2;-reveal{anchor-name}#}: {#0;highlight{ident}#}({#4;reveal{var(--tree-name) }#}'{#4;-reveal{--item}#}-' {#1;highlight green{sibling-index()}#});
}
{#3;insert{.label {
	anchor-name: ident(var({#3;highlight blue{--item-name}#}) '-label');
}
.connector {
	position-anchor: ident(var({#3;highlight blue{--item-name}#}) '-label');
}
}#}`} class="s06 self-center" />
