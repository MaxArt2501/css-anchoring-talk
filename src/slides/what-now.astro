<style>
	nav {
		position: relative;
		align-self: center;
		font-size: 70%;
		ul {
			display: flex;
			list-style-type: '';
			margin: 0;
			padding: 0;
		}
		li {
			padding: .5em 1em;
		}
		a {
			text-decoration: none;
			color: inherit;
		}
		&::after {
			content: '';
			position: absolute;
			inset: 100% 0 0;
			border: .125em solid var(--brand-color);
			background: color-mix(in srgb, var(--brand-color), transparent 50%);
			z-index: -1;
			border-radius: .5em;
			corner-shape: squircle;
		}
		&:has([index=':aName'][aria-hidden='false']) {
			&::after {
				position-anchor: --current-item;
			}
			li {
				anchor-name: --current-item;
			}
		}
		&:has([index=':anchor'][aria-hidden='false']) {
			&::after {
				inset: anchor(inside);
			}
		}
		&:has([index=':onHover'][aria-hidden='false']) {
			li {
				anchor-name: none;
				&:hover {
					anchor-name: --current-item;
				}
			}
		}
		&:has([index=':fback'][aria-hidden='false']) {
			&::after {
				inset: anchor(top, 100%) anchor(inside, 0) anchor(inside, 0);
			}
		}
		&:has([index=':xition'][aria-hidden='false']) {
			&::after {
				transition: inset 300ms;
			}
		}
	}
</style>
<p-slide flex gap="1" class="align-center">
	<p-fragment index="7" p-effect="reveal" aria-hidden="false">
		<p-fragment p-effect="reveal" flex="column" gap="1" class="s05">
			<Code lang="html" code={`<div class="grid">
	<div class="cell">
		<div class="content">1</div>
	</div>
	...
</div>`}/>
