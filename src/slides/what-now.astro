---
import Code from "../components/Code.astro";
---

<p-slide>
	<h3 class="center">Now we can do&hellip;</h3>
	<ul class="self-center s2">
		<li p-fragment p-effect="dropping from below">menus</li>
		<li p-fragment p-effect="dropping from below">tooltips</li>
	</ul>
</p-slide>
<p-slide>
	<p-fragment p-effect="push-away" p-duration="3">
		<img src="../img/push-hand.svg" alt="" p-effect="move">
		<div class="slide">
			<h2 class="h1 center nowrap">
				<strong>That's all, folks!</strong>
			</h2>
			<div class="h1 self-center waving-hand">👋</div>
		</div>
	</p-fragment>
	<p-fragment class="h3 center">We can do <strong>much more</strong>&hellip;</p-fragment>
</p-slide>
<style>
	[p-effect="push-away"] {
		position: absolute;
		inset-inline-end: 0;
		display: grid;
		grid-template-columns: auto 100cqw;
		translate: calc((100cqw + 5.92em) * var(--fragment-progress)) 0;
		transition-timing-function: linear(0, .8 30%, .5 40% 80%, 1);
		transition-timing-function: linear(
			0 0%, 0.0196 4%, 0.0764 8%, 0.165 12%, 0.276 16%, 0.4 20%, 0.524 24%, 0.635 28%, 0.724 32%, 0.78 36%, 0.8 40%,
			0.793 42%, 0.771 44%, 0.738 46%, 0.696 48%, 0.65 50%, 0.604 52%, 0.562 54%, 0.529 56%, 0.507 58%, 0.5 60% 70%,
			0.524 76%, 0.595 82%, 0.706 88%, 0.845 94%, 1
		);

		img {
			height: 8em;
			--to-x: 3.6em;
		}
		.slide {
			flex-grow: 1;
			display: flex;
			flex-direction: column;
			min-width: 100%;
		}
	}
</style>
<p-slide>
	<div class="fixed-scroll">
    <svg viewBox="-40 40 720 200">
      <use href="#latinWiki" p-fragment="1" p-effect="move" y="-300" style="--to-y: -150px" />
      <rect x="-40" y="40" height="200" width="720" fill="none" stroke="currentColor" stroke-width="4"/>
      <rect x="665" y="45" height="100" width="10" rx="5" fill="#0005" p-fragment="1" p-effect="move" style="--to-y: 40px"/>
    </svg>
		<p-fragment index="1" p-effect="move-inside">
			<p-fragment index="0" p-effect="fade" popover="manual">
				François-Marie Arouet, 1694-1778
			</p-fragment>
		</p-fragment>
  </div>
	<svg class="circled" viewBox="0 0 10 10" preserveAspectRatio="none">
		<path d="M8,8a4.5,4 0 1 1 0,-6a2.7,2 20 1 1 -5,4.5" p-fragment p-effect="drawing" />
	</svg>
</p-slide>
<style>
	.fixed-scroll {
		align-items: center;
		svg {
			width: 14.4em;
			height: 4em;
		}
		[popover] {
			display: block;
			inset-block-start: 29.5em;
		}
		[p-effect="move-inside"] {
			--number-1: var(--fragment-progress);
			[popover] {
				inset-block-start: calc(29.5em - var(--number-1) * 6.7em);
			}
		}
		+ .circled {
			inset: 3.1em auto auto 14em;
			width: 10em;
			height: 3em;
		}
	}
</style>
<p-slide class="stack outside-borders">
	<svg viewBox="-40 40 720 440">
		<use href="#latinWiki" y="-300" />
	</svg>
	<Code lang="css" theme="github-light" code={`.dialog {
	background: #fff;
	border-radius: 0.5rem;
	border: none;
	...
{#insert{	anchor-name: --dlg;
}#}}
{#0:btn;insert{.close-button {
	position: absolute;
{#insert{	position-anchor: --dlg;
}#}	top: {#:fix;reveal{calc(anchor(inside) }#}{#:clip;reveal{-}#}{#:fix;reveal{ }#}{#:clip;reveal{1rem}#}{#:clip;-reveal{0}#}{#:fix;reveal{)}#};
	right: {#:fix;reveal{calc(anchor(inside) }#}{#:clip;reveal{-}#}{#:fix;reveal{ }#}{#:clip;reveal{1rem}#}{#:clip;-reveal{0}#}{#:fix;reveal{)}#};
	border-radius: 100vmax;
	border: 1px solid white;            
}}#}`} class="self-center the-dialog"><p-fragment class="scrollbar" index=":btn" /></Code>
	<p-fragment index=":btn">
		<p-fragment index="4:fix" p-effect="btn-fix">
			<p-fragment index="1:clip" p-effect="btn-clip">
				<div class="close-button"></div>
			</p-fragment>
		</p-fragment>
	</p-fragment>
	<svg class="circled" viewBox="0 0 10 10" preserveAspectRatio="none">
		<path d="M8,8a4.5,4 0 1 1 0,-6a2.7,2 20 1 1 -5,4.5" p-fragment p-effect="drawing" />
	</svg>
</p-slide>
<style>
	.outside-borders {
		--slide-bg: #aaa;

		svg:not(.circled) {
			width: 23em;
			filter: blur(0.05em);
		}
		.the-dialog {
			z-index: 1;
			width: max-content;
			margin-inline: auto;
			height: 12em;
			overflow: auto;
			scrollbar-width: none;
			anchor-name: --the-dialog;
		}
		.scrollbar {
			position: absolute;
			position-anchor: --the-dialog;
			inset: calc(anchor(inside) + .1em) calc(anchor(inside) + .1em) auto auto;
			width: .25em;
			height: 50%;
			background: gray;
			border-radius: 100vmax;
		}
		.close-button {
			border: .1em solid #aaa;
			border-radius: 100vmax;
			width: 1.5em;
			height: 1.5em;
			position: relative;

			&::before {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(white, white) 50% / 1em .1em no-repeat, linear-gradient(white, white) 50% / .1em 1em no-repeat var(--brand-color);
				rotate: 45deg;
				border-radius: 100vmax;
			}
			p-fragment:has(&) {
				position: absolute;
			}
		}
		> p-fragment {
			position-anchor: --the-dialog;
			inset: anchor(top) anchor(right) auto auto; 
			z-index: 2;
		}
		[p-effect="btn-clip"] {
			right: 0;
			translate: calc(50% * var(--fragment-progress)) calc(-50% * var(--fragment-progress));
			clip-path: inset(calc(var(--percentage-1) * var(--fragment-progress)) calc(var(--percentage-1) * var(--fragment-progress)) 0 0);
		}
		[p-effect="btn-fix"] {
			right: 0;
			--percentage-1: calc(50% * (1 - var(--fragment-progress)));
		}
		.circled {
			z-index: 3;
			inset: -1em 1.5em auto auto;
			width: 2em;
		}
	}
</style>
<p-slide flex gap="1" class="align-center">
	<div grid class="stack align-center" p-fragment p-effect="reveal">
		<Code lang="html" code={`<nav>
	<ul>
		<li><a href="...">Home</a></li>
		<li><a href="...">Blog</a></li>
		<li><a href="...">Links</a></li>
	</ul>
</nav>`} class="s05" p-fragment=":toCss" p-effect="move from start" p-initially-visible />
		<Code lang="css" code={`nav {
	position: relative;

	&::before {
		content: '';
		position: absolute;
{#3;insert{		position-anchor: --current-item;
}#}		inset: {#4:anchor;-reveal{100% 0 0}#}{#:anchor;reveal{anchor(inside{#6:fback;reveal{, {#:fback;highlight{0}#}}#})}#};
{#:fback;insert{		inset-block-start: anchor(top, {#:fback;highlight{100%}#});
}#}{#7:xition;insert{		transition: inset 250ms;
}#}	}
{#2:aName;insert{
	li{#5:onHover;reveal{:hover}#} {
		anchor-name: --current-item;
	}
}#}}`} class="s05" p-fragment=":toCss" p-effect="move from below" />
	</div>
	<nav>
		<p-fragment index=":aName"></p-fragment>
		<p-fragment index=":anchor"></p-fragment>
		<p-fragment index=":onHover"></p-fragment>
		<p-fragment index=":fback"></p-fragment>
		<p-fragment index=":xition"></p-fragment>
		<ul>
			<li><a href=".">Home</a></li>
			<li><a href=".">Blog</a></li>
			<li><a href=".">Links</a></li>
		</ul>
	</nav>
</p-slide>
<style>
	nav {
		position: relative;
		align-self: center;
		font-size: 70%;
		ul {
			display: flex;
			list-style-type: '';
			margin: 0;
			padding: 0;
		}
		li {
			padding: .5em 1em;
		}
		a {
			text-decoration: none;
			color: inherit;
		}
		&::after {
			content: '';
			position: absolute;
			inset: 100% 0 0;
			border: .125em solid var(--brand-color);
			background: color-mix(in srgb, var(--brand-color), transparent 50%);
			z-index: -1;
			border-radius: .5em;
			corner-shape: squircle;
		}
		&:has([index=':aName'][aria-hidden='false']) {
			&::after {
				position-anchor: --current-item;
			}
			li {
				anchor-name: --current-item;
			}
		}
		&:has([index=':anchor'][aria-hidden='false']) {
			&::after {
				inset: anchor(inside);
			}
		}
		&:has([index=':onHover'][aria-hidden='false']) {
			li {
				anchor-name: none;
				&:hover {
					anchor-name: --current-item;
				}
			}
		}
		&:has([index=':fback'][aria-hidden='false']) {
			&::after {
				inset: anchor(top, 100%) anchor(inside, 0) anchor(inside, 0);
			}
		}
		&:has([index=':xition'][aria-hidden='false']) {
			&::after {
				transition: inset 300ms;
			}
		}
	}
</style>
<p-slide flex gap="1" class="align-center">
	<p-fragment index="7" p-effect="reveal" aria-hidden="false">
		<p-fragment p-effect="reveal" flex="column" gap="1" class="s05">
			<Code lang="html" code={`<div class="grid">
	<div class="cell">
		{#2;highlight blue{{#2;reveal{<div class="content">}#}1{#2;reveal{</div>}#}}#}
	</div>
	...
</div>`}/>
			<Code lang="css" code={`.grid {
	grid-template-columns: repeat(auto-fit, 2em);
	grid-auto-rows: 2em;
}{#2;insert{.cell {
	anchor-name: --cell;
	anchor-scope: --cell;
}}#}{#3;insert{.{#3;highlight blue{content}#} {
	position: absolute;
	position-anchor: --cell;
{#insert{	inset: anchor(inside);
}#}{#:last;insert{	{#:last;highlight green{transition: inset 300ms}#};
}#}}}#}`} p-fragment p-effect="insert"/>
		</p-fragment>
	</p-fragment>
	<div class="dynamic-grid-container"><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><p-fragment index="6">👾</p-fragment><span/><span/><span/><span/></div>
</p-slide>
<style>
	.dynamic-grid-container {
		display: grid;
		gap: .25em;
		grid-template-columns: repeat(auto-fit, 2em);
		grid-auto-rows: 2em;
		flex-grow: 1;
		transition: margin-bottom 300ms;

		span {
			counter-increment: dynamic-grid-item;
			anchor-name: --dynamic-grid-item;
			anchor-scope: --dynamic-grid-item;
			
			&::before {
				content: counter(dynamic-grid-item);
				position: absolute;
				position-anchor: --dynamic-grid-item;
				inset: anchor(inside);
				transition: inset 300ms;
				width: 2em;
				height: 2em;
			}
		}
		p-fragment {
			display: none;
			grid-area: 3 / 2 / span 2 / span 2;
			width: .25em;
			height: .25em;
			transition-behavior: allow-discrete;
			transition-property: width, height, display;
			transition-duration: 300ms;
			opacity: 1;
			
			&[aria-hidden='false'] {
				display: block;
				width: 4.25em;
				height: 4.25em;
				
				@starting-style {
					width: .25em;
					height: .25em;
				}
			}
		}
		&:has(> p-fragment[aria-hidden='false']) {
			margin-bottom: -2.25em;
		}
		span::before, p-fragment {
			align-content: center;
			text-align: center;
			border: .125em solid var(--brand-color);
			background: color-mix(in srgb, var(--brand-color), transparent 50%);
			border-radius: .25em;
		}
	}
</style>
<p-slide>
	<ul class="folder-tree" p-fragment p-effect="stretch">
		<li>
			<div>
				<img src="../img/win95-computer-16-icon.png" alt="">
				<span>My Computer</span>
			</div>
			<ul>
				<li>
					<div>
						<img src="../img/win95-hdd-16-icon.png" alt="">
						<span>MY_STUFF (C:)</span>
						<button type="button" command="--toggle-subtree" commandfor="hard-disk-c-1"></button>
					</div>
					<ul id="hard-disk-c-1">
						<li>
							<div>
								<img src="../img/win95-folder-explorer-16-icon.png" alt="">
								<span>Dos</span>
							</div>
						</li>
						<li>
							<div>
								<img src="../img/win95-folder-explorer-16-icon.png" alt="">
								<span>Program Files</span>
								<button type="button" command="--toggle-subtree" commandfor="program-files-1"></button>
							</div>
							<ul id="program-files-1" style="anchor-name: --long-line">
								<li>
									<div>
										<img src="../img/win95-folder-explorer-16-icon.png" alt="">
										<span>Microsoft Excel</span>
									</div>
								</li>
								<li>
									<div>
										<img src="../img/win95-folder-explorer-16-icon.png" alt="">
										<span>Microsoft Word</span>
									</div>
								</li>
							</ul>
						</li>
						<li>
							<div>
								<img src="../img/win95-folder-explorer-16-icon.png" alt="">
								<span>Windows</span>
								<button type="button" command="--toggle-subtree" commandfor="windows-1"></button>
							</div>
							<ul id="windows-1">
								<li>
									<div>
										<img src="../img/win95-folder-explorer-16-icon.png" alt="">
										<span>Fonts</span>
									</div>
								</li>
								<li>
									<div>
										<img src="../img/win95-folder-explorer-16-icon.png" alt="">
										<span>System</span>
									</div>
								</li>
								<li>
									<div>
										<img src="../img/win95-folder-explorer-16-icon.png" alt="">
										<span>Temp</span>
									</div>
								</li>
							</ul>
						</li>
					</ul>
				</li>
				<li>
					<div>
						<img src="../img/win95-bin-16-icon.png" alt="">
						<span>Recycle Bin</span>
					</div>
				</li>
			</ul>
		</li>
	</ul>
	<svg class="circled" viewBox="0 0 10 10" preserveAspectRatio="none">
		<path d="M8,8a4.5,4 0 1 1 0,-6a2.7,2 20 1 1 -5,4.5" p-fragment p-effect="drawing" />
	</svg>
</p-slide>
<style>
	.folder-tree {
		--length-1: .05em;
		--px: var(--length-1);
		--from-width: 10em;
		--to-width: 7em;
		--from-height: 11em;
		font-family: MSW98UI, sans-serif;
		border: calc(var(--px) * 2) solid;
		border-image-slice: 40%;
		border-image-width: calc(var(--px) * 2);
		border-image-source: var(--button-active-border-image);
		image-rendering: pixelated;
		padding-inline-start: 0;
		align-self: center;
		pointer-events: auto;
		margin: auto;

		&, button {
			cursor: url(../img/win95-cursor.svg), default;
		}
		
		&, ul {
			list-style-type: '';
			position: relative;
		}
		ul {
			padding-inline-start: calc(var(--px) * 16);
		}
		li {
			font-size: calc(var(--px) * 11);
			line-height: calc(var(--px) * 16);
			padding-inline-start: calc(var(--px) * 3);
			
			li div::before {
				content: '';
				position: absolute;
				position-anchor: --explorer-item-1;
				border-left: var(--px) dotted gray;
				border-bottom: var(--px) dotted gray;
				top: 0;
				width: calc(var(--px) * 14);
				right: calc(anchor(left) - var(--px) * 3);
				bottom: calc(anchor(top) - var(--px) * 10);
				z-index: -1;
			}

			&:not(:last-of-type) {
				> div::before {
					border-left-color: transparent;
				}
			}
		}
		div {
			display: flex;
			anchor-name: --explorer-item-1;
			anchor-scope: --explorer-item-1;

			&:has(> button:not([aria-expanded='true'])) + ul {
				display: none;
			}
		}
		img {
			height: calc(var(--px) * 16);
			margin-right: calc(var(--px) * 4);
			vertical-align: bottom;
		}
		span {
			padding-inline-start: calc(var(--px) * 3);
		}
		button {
			position: absolute;
			position-anchor: --explorer-item-1;
			border: var(--px) solid gray;
			padding: var(--px);
			width: calc(var(--px) * 9);
			height: calc(var(--px) * 9);
			background: linear-gradient(#000, #000) 50% 50% / var(--px) calc(var(--px) * 5) no-repeat,
				white linear-gradient(#000, #000) 50% 50% / calc(var(--px) * 5) var(--px) no-repeat;
			left: calc(anchor(left) - var(--px) * 15);
			top: calc(anchor(top) + var(--px) * 5);
			&[aria-expanded='true'] {
				/* padding-block: calc(var(--px) * 3); */
				background: white linear-gradient(#000, #000) 50% 50% / calc(var(--px) * 5) var(--px) no-repeat;
			}
		}
	}
	.circled {
		position-anchor: --long-line;
		pointer-events: none;
		height: anchor-size();
		width: 1em;
		inset: anchor(top) auto auto anchor(left);
	}
</style>
<p-slide flex gap="1" class="align-center justify-center">
	<p-fragment p-effect="reveal" class="s05">
		<Code lang="html" code={`{#:outer;highlight blue{<li class="item">
	{#:label;highlight red{<div class="label">
		<img class="icon" src="...">
		Program Files
	</div>}#}
	{#:inner;highlight green{<ul class="tree">
		<li class="item">
			<div class="label">
				<img class="icon" src="...">
				Microsoft Excel
				{#:conn;highlight yellow{<hr class="connector">}#}
			</div>
		</li>
		...
	</ul>}#}
</li>}#}`}/>
	</p-fragment>
	<ul class="folder-tree" style="--length-1: .08em">
		<li>
			<div>
				<img src="../img/win95-folder-explorer-16-icon.png" alt="">
				<span>Program Files</span>
			</div>
			<ul id="program-files-1" style="anchor-name: --long-line">
				<li>
					<div>
						<img src="../img/win95-folder-explorer-16-icon.png" alt="">
						<span>Microsoft Excel</span>
					</div>
				</li>
				<li>
					<div>
						<img src="../img/win95-folder-explorer-16-icon.png" alt="">
						<span>Microsoft Word</span>
					</div>
				</li>
			</ul>
		</li>
		<p-fragment p-group="outer" p-effect="blue frame" style="inset: 0"></p-fragment>
		<p-fragment p-group="label" p-effect="red frame" style="inset: .1em .1em auto; height: calc(var(--px) * 16)"></p-fragment>
		<p-fragment p-group="inner" p-effect="green frame" style="inset: auto .1em .1em .5em; height: calc(var(--px) * 32)"></p-fragment>
		<p-fragment p-group="conn" p-effect="yellow frame" style="inset: auto 7.7em .2em .6em; height: calc(var(--px) * 32 - .1em)"></p-fragment>
	</ul>
</p-slide>
<p-slide flex gap="1" class="align-center justify-center">
	<Code lang="css" code={`.tree {
{#7;insert{	position: relative;
}#}}
.label {
{#9;-insert{{#2;insert{	{#6;strike{position: relative;}#}
}#}}#}{#9;insert{	anchor-name: --item-label;
}#}}
.connector {
{#insert{	position: absolute;
}#}{#1;insert{	width: 12px;
}#}{#9;-insert{{#3;insert{	{#8;-reveal{{#6;strike{height: {#5;-reveal{9px}#}{#5;reveal{???}#};}#}}#}{#8;reveal{height: ???;}#}
}#}}#}{#9;insert{	position-anchor: --item-label;
}#}{#insert{	right: anchor(left);
}#}{#insert{	bottom: calc(anchor(bottom) + 5px);
}#}{#12;insert{	top: 0;
}#}}`} class="s06"/>
	<ul class="folder-tree" id="building" style="--length-1: .08em">
		<li>
			<div>
				<img src="../img/win95-folder-explorer-16-icon.png" alt="">
				<span>Program Files</span>
			</div>
			<ul id="program-files-1" style="anchor-name: --long-line">
				<li p-fragment="4" p-effect="insert">
					<div>
						<span>...</span>
					</div>
				</li>
				<li>
					<div>
						<img src="../img/win95-folder-explorer-16-icon.png" alt="">
						<span>Microsoft Excel</span>
						<p-fragment index="3" p-effect="height-next" />
						<p-fragment index="12" p-effect="stretch-next" />
						<p-fragment index="13" p-effect="move-next" />
						<span class="connector" p-fragment="1" p-effect="stretch" style="--from-width: var(--px); --to-width: calc(var(--px) * 12)"></span>
