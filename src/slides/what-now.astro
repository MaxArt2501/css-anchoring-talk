<style>
	#temani-arrow {
		.temani-arrow {
			/* arrow size  */
			--a: calc(1.7em / 3);
			--b: calc(2.0em / 3);
			/* */
			--c: .4em; /* control line height */
			--r: .4em; /* radius of the small cirles  */
			/**/
			--g: calc(1em / 3); /* gap between the arrow and circles */
			pointer-events: none;
			--r1: calc(170px / 2);
			--r2: calc(100px / 2);
		}

		.temani-arrow :is(a,b,c,d) {
			position: absolute;
			--_x: calc(anchor(--temani-circle-a inside) + anchor-size(--temani-circle-a)/2 - .1px);
			--_y: calc(anchor(--temani-circle-b inside) + anchor-size(--temani-circle-b)/2);
			container-type: size;
		}
		.temani-arrow :is(a,b) {top:  var(--_x); bottom: var(--_y)}
		.temani-arrow :is(a,c) {left: var(--_x); right:  var(--_y)}
		.temani-arrow :is(c,d) {top:  var(--_y); bottom: var(--_x)}
		.temani-arrow :is(b,d) {left: var(--_y); right:  var(--_x)}

		.temani-arrow :is(a,b,c,d):before {
			content: "";
			position: absolute;
			inset: calc(100% - var(--a)) 0 calc(-1*var(--a)) calc(100% - hypot(100cqh,100cqw));
			rotate: atan(100cqh/100cqw);
			border-image: conic-gradient(#556270) fill 0//999px;
			transform-origin: right;
			--_m0: sign(hypot(100cqh,100cqw) - var(--r1) - var(--r2) - 3*(var(--b) + var(--g)));
			--_m1: sign(hypot(100cqh,100cqw) - var(--r1) - var(--r2));
			padding-inline: 
				calc((var(--r1) + var(--g))*var(--_m0)) 
				calc((var(--r2) + var(--g))*var(--_m0));
			opacity: calc(sign(1cqw)*sign(1cqh)*var(--_m1));
			--_d: calc(var(--r)*cos(asin(var(--c)/(2*var(--r)))));
			clip-path: if(style(--_m0 = 1):
				polygon(var(--b) 0,var(--b) var(--c),calc(100% - var(--b)) var(--c),calc(100% - var(--b)) 0,100% 50%,calc(100% - var(--b)) 100%,calc(100% - var(--b)) calc(100% - var(--c)),var(--b) calc(100% - var(--c)),var(--b) 100%,0 50%) content-box;
				else:
				shape(from var(--_d) var(--c),
						arc to var(--_d) calc(100% - var(--c)) of var(--r) large,
					hline to calc(100% - var(--_d)), 
						arc to calc(100% - var(--_d)) var(--c) of var(--r) large
				););
		}
		.temani-arrow b {scale: -1  1}
		.temani-arrow c {scale:  1 -1}
		.temani-arrow d {scale: -1 -1}

		.temani-circle {
			position: absolute;
			left: 10%;
			top: 10%;
			aspect-ratio: 1;
			background: #45ADA8;
			border-radius: 50%;
			anchor-name: --temani-circle-a;
		}
		.temani-circle + .temani-circle {
			background: var(--brand-color);
			left: 72%;
			top: 40%;
			anchor-name: --temani-circle-b;
		}
		p {
			font-size: 50%;
			position: absolute;
			inset: auto 2em 2em auto;
		}
	}
</style>
