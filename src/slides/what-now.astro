	<div class="dynamic-grid-container"><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><span/><p-fragment index="6">👾</p-fragment><span/><span/><span/><span/></div>
</p-slide>
<style>
	.dynamic-grid-container {
		display: grid;
		gap: .25em;
		grid-template-columns: repeat(auto-fit, 2em);
		grid-auto-rows: 2em;
		flex-grow: 1;
		transition: margin-bottom 300ms;

		span {
			counter-increment: dynamic-grid-item;
			anchor-name: --dynamic-grid-item;
			anchor-scope: --dynamic-grid-item;
			
			&::before {
				content: counter(dynamic-grid-item);
				position: absolute;
				position-anchor: --dynamic-grid-item;
				inset: anchor(inside);
				transition: inset 300ms;
				width: 2em;
				height: 2em;
			}
		}
		p-fragment {
			display: none;
			grid-area: 3 / 2 / span 2 / span 2;
			width: .25em;
			height: .25em;
			transition-behavior: allow-discrete;
			transition-property: width, height, display;
			transition-duration: 300ms;
			opacity: 1;
			
			&[aria-hidden='false'] {
				display: block;
				width: 4.25em;
				height: 4.25em;
				
				@starting-style {
					width: .25em;
					height: .25em;
				}
			}
		}
		&:has(> p-fragment[aria-hidden='false']) {
			margin-bottom: -2.25em;
		}
		span::before, p-fragment {
			align-content: center;
			text-align: center;
			border: .125em solid var(--brand-color);
			background: color-mix(in srgb, var(--brand-color), transparent 50%);
			border-radius: .25em;
		}
	}
</style>