			corner-shape: squircle;
			padding: 1em;
			anchor-name: --item-label;
			anchor-scope: --item-label;
		}
		.connector {
			&::before, &::after {
				content: '';
				position: absolute;
				position-anchor: --item-label;
				background: #444;
			}
			&::after {
				inset: -2em anchor(50%) anchor(top) calc(50% - .1em);
				clip-path: shape(
					from 0 0,
					hline to .2em,
					arc to 50% calc(50% - .1em) of calc(50% - .2em) calc(50% - .1em),
					arc to 100% 100% of 50% calc(50% + .1em) cw,
					hline by -.2em,
					arc to 50% calc(50% + .1em) of calc(50% - .2em) calc(50% - .1em),
					arc to 0 0 of 50% calc(50% + .1em) cw,
				);
			}
			&::before {
				inset: -2em calc(50% - .1em) anchor(top) anchor(50%);
				clip-path: shape(
					from 100% 0,
					hline by -.2em,
					arc to 50% calc(50% - .1em) of calc(50% - .2em) calc(50% - .1em) cw,
					arc to 0 100% of 50% calc(50% + .1em),
					hline by .2em,
					arc to 50% calc(50% + .1em) of calc(50% - .2em) calc(50% - .1em) cw,
					arc to 100% 0 of 50% calc(50% + .1em),
				);
			}
		}
	}
	[p-effect='tilt-and-scale-inside'] {
		container-type: inline-size;
		flex-grow: 1;
		transition-timing-function: linear(0, 11 10%, 7, 11, 7, 11, 7, 11, 7, 11 90%, 1);

		> .tree-chart {
			font-size: 6cqw;
		}

		.connector {
			&::before, &::after {
				scale: calc(1 + max(0, var(--fragment-progress) - 1) * .01);
				rotate: calc(max(0, var(--fragment-progress) - 1) * -1deg);
				background-image: radial-gradient(circle at center, red calc(min(1, var(--fragment-progress)) * 100%), #444 0);
			}
		}
		[p-effect="stretch"] {
			position: absolute;
			border: 0q dashed;

			&[index="1"] {
				border-inline-start-width: .1em;
				color: blue;
				inset: -.5em auto auto calc(50% - .05em);
				--to-height: calc(100% + 1.5em);
			}
			&[index=":top"] {
				border-block-start-width: .1em;
				color: green;
				inset: calc(2.125em + 1lh) auto auto -.5em;
				--to-width: calc(100% + 1em);
			}
			&[index=":bottom"] {
				border-block-start-width: .1em;
				color: yellow;
				inset: calc(4.25em + 1lh) auto auto -.5em;
				--to-width: calc(100% + 1em);
			}
			&[index=":left"] {
				border-inline-start-width: .1em;
				color: maroon;
				inset: calc(1.75em + 1lh) auto auto 2.125em;
				--to-height: calc(5.75em + 1lh);
			}
			&[index=":right"] {
				background: #00f5;
				inset: calc(2.225em + 1lh) auto auto 2.225em;
				height: 2em;
				--to-width: calc(50% - 2.225em);
			}
			&[index$=":oops"] {
				border-inline-start-width: .1em;
				color: maroon;
				inset: calc(1.75em + 1lh) auto auto 10.925em;
				--to-height: calc(5.75em + 1lh);
			}
			&[index=":after-right"] {
				background: #f005;
				inset: calc(2.225em + 1lh) auto auto 50%;
				height: 2em;
				--to-width: calc(10.925em - 50%);
			}
		}
	}
	[p-effect~="highlight-box"] {
		position: absolute;
